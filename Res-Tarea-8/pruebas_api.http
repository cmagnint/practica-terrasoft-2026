    "rut": "10111111-1",
    "telefono": "999999999",
    "email": "duplicado@mail.com"
}

### crear vehiculo - 201

POST http://127.0.0.1:8000/api/vehiculos/
Content-Type: application/json

{
    "patente": "TEST10",
    "marca": "Kia",
    "modelo": "Stinger",
    "anio": 2025,
    "color": "Negro",
    "kilometraje": 10000,
    "cliente": 32
}

### crear orden - 201

POST http://127.0.0.1:8000/api/ordenes/
Content-Type: application/json

{
    "vehiculo": 46,
    "mecanico": 14,
    "descripcion": "Cambio de aceite",
    "estado": "Pendiente",
    "fecha_entrega_estimada": "2026-05-20",
    "observaciones": "Se hizo el cambio de aceite"
}


