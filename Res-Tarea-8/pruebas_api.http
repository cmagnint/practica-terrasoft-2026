Authorization: Bearer {{loginAdmin.response.body.access}}
Content-Type: application/json

{
    "vehiculo": 1,
    "mecanico": 1,
    "descripcion": "Revision checklist final",
    "fecha_entrega_estimada": "2026-06-20",
    "observaciones": "Prueba checklist"
}


### 9. ADMIN CREA VEHICULO debe dar 201
POST http://127.0.0.1:8000/api/vehiculos/
Authorization: Bearer {{loginAdmin.response.body.access}}
Content-Type: application/json

{
    "patente": "ZZ9988",
    "marca": "Toyota",
    "modelo": "Yaris GR",
    "anio": 2021,
    "color": "Blanco",
    "kilometraje": 30000,
    "cliente": 1
}


### 10. JUAN VE SOLO SUS VEHICULOS no deben salir los 35
GET http://127.0.0.1:8000/api/vehiculos/
Authorization: Bearer {{loginCliente.response.body.access}}


### 11. JUAN VE SUS ORDENES debe dar 200, no 403
GET http://127.0.0.1:8000/api/ordenes/
Authorization: Bearer {{loginCliente.response.body.access}}


### 12. CARLOS VE SUS CLIENTES debe dar 200, no 403
GET http://127.0.0.1:8000/api/clientes/
Authorization: Bearer {{loginMecanico.response.body.access}}


### 13. CARLOS VE MECANICOS DISPONIBLES debe dar 200
GET http://127.0.0.1:8000/api/mecanicos/disponibles/
Authorization: Bearer {{loginMecanico.response.body.access}}


### 14. CARLOS COMPLETA ORDEN AJENA -> debe dar 403, no 404
POST http://127.0.0.1:8000/api/ordenes/2/completar/
Authorization: Bearer {{loginMecanico.response.body.access}}
Content-Type: application/json

{
    "monto": 85000,
    "fecha_entrega_real": "2026-06-20"
}


### 15. DELETE MECANICO debe dar 405
DELETE http://127.0.0.1:8000/api/mecanicos/11111111-1/
Authorization: Bearer {{loginAdmin.response.body.access}}


### 16. BUSCAR CLIENTE JUAN debe dar 200, no 500
GET http://127.0.0.1:8000/api/clientes/?buscar=Juan
Authorization: Bearer {{loginAdmin.response.body.access}}


### 17. ORDENES PAGINADAS debe tener count, next, previous, results
GET http://127.0.0.1:8000/api/ordenes/
Authorization: Bearer {{loginAdmin.response.body.access}}


### 18. ORDENES PAGINA 2 PAGE SIZE 10 results debe tener 10 items si hay suficientes datos
GET http://127.0.0.1:8000/api/ordenes/?page=2&page_size=10
Authorization: Bearer {{loginAdmin.response.body.access}}


### 19. ADMIN CREA CLIENTE PARA AUDITORIA debe dar 201
POST http://127.0.0.1:8000/api/clientes/
Authorization: Bearer {{loginAdmin.response.body.access}}
Content-Type: application/json

{
    "nombre": "Cliente Prueba",
    "rut": "66666666-6",
    "telefono": "666666666",
    "email": "clientePrueba@gmail.com"
}


### 20. AUDIT LOG CREAR CLIENTE debe contener crear_cliente
GET http://127.0.0.1:8000/api/audit-logs/?accion=crear_cliente
Authorization: Bearer {{loginAdmin.response.body.access}}


### 21. REDOC -> debe dar 200
GET http://127.0.0.1:8000/api/redoc/
```



###===================================================
### PRUEBAS ENTREGAS ANTERIORES
###===================================================



### 1. Lista todos los mecánicos
GET http://localhost:8000/api/mecanicos/

###

### 2. Solo mecánicos de Motor
GET http://localhost:8000/api/mecanicos/?especialidad=Motor

###

### 3. Detalle de mecánico con stats
GET http://localhost:8000/api/mecanicos/11111111-1/

###

### 4. Crear mecánico válido → 201
POST http://localhost:8000/api/mecanicos/
Content-Type: application/json

{
    "nombre": "Mecánico Nuevo",
    "rut": "21111111-1",
    "especialidad": "Electricidad",
    "activo": true
}

###

### 5. Crear mecánico con RUT duplicado → 400
POST http://localhost:8000/api/mecanicos/
Content-Type: application/json

{
    "nombre": "Otro",
    "rut": "11111111-1",
    "especialidad": "General",
    "activo": true
}

###

### 6. Lista clientes con vehículos anidados
GET http://localhost:8000/api/clientes/

###

### 7. Solo clientes con vehículos
GET http://localhost:8000/api/clientes/?con_vehiculos=true

###

### 8. Detalle de cliente con stats
GET http://localhost:8000/api/clientes/10111111-1/

###

### 9. Vehículos marca Toyota
GET http://localhost:8000/api/vehiculos/?marca=Toyota

###

### 10. Detalle de vehículo con cliente y órdenes anidados
GET http://localhost:8000/api/vehiculos/ABCD00/

###

### 11. Órdenes pendientes
GET http://localhost:8000/api/ordenes/?estado=Pendiente

###

### 12. Órdenes vencidas
GET http://localhost:8000/api/ordenes/?vencidas=true

###

### 13. Crear orden válida → 201
POST http://localhost:8000/api/ordenes/
Content-Type: application/json

{
    "vehiculo": 46,
    "mecanico": 14,
    "descripcion": "Cambio aceite",
    "fecha_entrega_estimada": "2026-05-15",
    "observaciones": "Vehiculo entra para cambio de aceite"
}

###

### 14. Completar orden con monto → 200
PATCH http://localhost:8000/api/ordenes/81/
Content-Type: application/json

{
    "estado": "Completada",
    "fecha_entrega_real": "2026-05-09",
    "monto": 85000
}

###

### 15. Completar orden sin monto → 400
PATCH http://localhost:8000/api/ordenes/85/
Content-Type: application/json

{
    "estado": "Completada"
}

